#!/bin/bash
# omarchy-dictionary-lookup: read the user's selected text and open the
# dictionary plugin with it. Designed to be bound to a global hotkey.
#
# Reads the primary selection (highlighted text, the X11/Wayland "middle-click
# paste" buffer) first; falls back to the regular clipboard if empty. Pulls
# the first alphabetic word out of whatever was selected so multi-word or
# punctuated selections still produce a clean lookup target.
#
# Tested in isolation via tests/lookup.test.js — the pure helpers below are
# extracted into the `dictionary_lookup_extract_word` function so the test
# harness can exercise them without an X server or running shell.

set -euo pipefail

# wayland_display
#   Hyprland doesn't export WAYLAND_DISPLAY to commands it spawns (unlike
#   processes launched from a terminal). wl-paste then defaults to
#   `wayland-0`, which is usually wrong. Recover the real display name
#   from the compositor socket, matching what omarchy-shell does.
wayland_display() {
  if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    printf '%s' "$WAYLAND_DISPLAY"
    return
  fi
  local socket
  socket=$(ls -t "${XDG_RUNTIME_DIR:-/run/user/$UID}"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n1 || true)
  if [[ -n "$socket" ]]; then
    printf '%s' "${socket##*/}"
  fi
}

# extract_word <string>
#   Returns the first run of ASCII letters in $1, or empty string if none.
#   Pure function — no I/O, no side effects.
extract_word() {
  printf '%s' "${1:-}" | grep -oP '[a-zA-Z]+' | head -n1 || true
}

# read_selection
#   Reads the Wayland primary selection (highlight), falling back to the
#   clipboard. Returns empty string if both are empty. stderr from wl-paste
#   (e.g. no compositor) is suppressed to keep the hotkey silent.
read_selection() {
  local sel
  sel=$(WAYLAND_DISPLAY="$(wayland_display)" wl-paste -p --no-newline 2>/dev/null || true)
  if [[ -z "$sel" ]]; then
    sel=$(WAYLAND_DISPLAY="$(wayland_display)" wl-paste --no-newline 2>/dev/null || true)
  fi
  printf '%s' "$sel"
}

# Main: with a selection → search the extracted word. Without one → just
# open the popup so the user can type. -q keeps the hotkey silent on
# failure (shell not running, plugin disabled, etc.).
word=$(extract_word "$(read_selection)")

if [[ -n "$word" ]]; then
  exec omarchy-shell -q tristonarmstrong.dictionary search "$word"
fi

exec omarchy-shell -q tristonarmstrong.dictionary toggle